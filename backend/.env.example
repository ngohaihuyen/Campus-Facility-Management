# Copy this file to ".env" and put in your own values.

PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=FacilityBookingDB

# Secret key for login tokens (any long random text)
JWT_SECRET=change_this_to_a_long_random_text

# University email domain. Only these emails can log in,
# e.g. anhnq2410071@usth.edu.vn (name letters + student code).
EMAIL_DOMAIN=usth.edu.vn
